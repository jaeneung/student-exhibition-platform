# Copy this file to .env for local development. Never commit the real .env —
# it's already gitignored (see .gitignore's ".env*" entry).
#
# Required for the /manage teacher login (see lib/auth.ts and README
# "교사 로그인"). The password is never stored in plaintext anywhere, only as
# a salted scrypt hash — generate your own with the snippet below rather than
# typing a real password into this file.
#
#   node -e "
#     const c = require('node:crypto');
#     const password = 'choose-a-real-password-here';
#     const salt = c.randomBytes(16).toString('hex');
#     console.log('TEACHER_PASSWORD_SALT=' + salt);
#     console.log('TEACHER_PASSWORD_HASH=' + c.scryptSync(password, salt, 64).toString('hex'));
#   "
#
TEACHER_USERNAME=
TEACHER_PASSWORD_SALT=
TEACHER_PASSWORD_HASH=

# Random secret used to sign the teacher login session cookie. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
