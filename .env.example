# Copy this file to .env for local development. Never commit the real .env —
# it's already gitignored (see .gitignore's ".env*" entry).
#
# Required for the /manage teacher login (see lib/auth.ts and README
# "교사 로그인"). The password is never stored in plaintext anywhere, only as
# a salted scrypt hash — generate your own with the snippet below rather than
# typing a real password into this file.
#
#   node -e "
#     const c = require('node:crypto');
#     const password = 'choose-a-real-password-here';
#     const salt = c.randomBytes(16).toString('hex');
#     console.log('TEACHER_PASSWORD_SALT=' + salt);
#     console.log('TEACHER_PASSWORD_HASH=' + c.scryptSync(password, salt, 64).toString('hex'));
#   "
#
TEACHER_USERNAME=
TEACHER_PASSWORD_SALT=
TEACHER_PASSWORD_HASH=

# Random secret used to sign the teacher login session cookie. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional — only needed for the media-relay-to-GitHub feature (a video or
# PDF over 4MB but under 40MB in the submission form's file-upload mode; see
# README "동영상/PDF 자동 업로드"). Without this set, that path fails
# gracefully with an error the student sees, and everything else in the app
# is unaffected.
#
# Create a fine-grained Personal Access Token at
# https://github.com/settings/personal-access-tokens/new scoped to ONLY this
# repository, with Repository permissions → Contents set to "Read and
# write". Never use a broad, all-repos token here — this value is a server
# secret capable of writing to whatever repo it's scoped to.
#
# The target repository (hardcoded in lib/github.ts) must be PUBLIC: GitHub
# only serves a Release asset's download URL to unauthenticated requests
# when the repo is public, so a private repo would 404 for every exhibition
# visitor trying to watch a relayed video.
GITHUB_MEDIA_TOKEN=
